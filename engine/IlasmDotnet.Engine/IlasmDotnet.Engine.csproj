<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IlasmDotnet.Engine</AssemblyName>
    <RootNamespace>IlasmDotnet.Engine</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The engine loads the assembly under analysis (and doubles as the JIT harness), so it must be
         able to run on a newer runtime than the one it was built for: an application published for
         .NET 11 cannot be loaded by the .NET 10 runtime the engine would otherwise pick. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <!-- A live process gives exact native code and the JIT mapping from native address to IL offset,
         which the environment variable route cannot provide. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <!-- ReadyToRun images of other targets are disassembled from the file, so the viewer needs a
         portable disassembler next to Iced: arm64 is decoded with Capstone. -->
    <PackageReference Include="Gee.External.Capstone" Version="2.3.0" />
    <!-- The ILASM round-trip needs a modern ilasm: the one from mono rejects the listing for types
         that implement interfaces. These are referenced with ExcludeAssets so that nothing is copied
         into the build output; scripts/copy-ilasm.mjs takes the binaries from the package cache and
         lays them out for out/engine/ilasm/<rid>/. -->
    <PackageReference Include="runtime.linux-x64.Microsoft.NETCore.ILAsm" Version="10.0.12" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="runtime.linux-arm64.Microsoft.NETCore.ILAsm" Version="10.0.12" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="runtime.osx-x64.Microsoft.NETCore.ILAsm" Version="10.0.12" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="runtime.osx-arm64.Microsoft.NETCore.ILAsm" Version="10.0.12" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="runtime.win-x64.Microsoft.NETCore.ILAsm" Version="10.0.12" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

</Project>
