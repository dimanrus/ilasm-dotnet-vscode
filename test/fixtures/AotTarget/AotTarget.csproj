<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AotTarget</AssemblyName>
    <RootNamespace>AotTarget</RootNamespace>
    <!-- The image is the point of this fixture: its bodies are machine code and there is no IL left
         in it, which is what the native route of the viewer has to cope with. Publishing keeps the
         default debug information, so the image is stripped and the line table lives in the .dbg
         file next to it - the arrangement a real application ships with. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
